{
  "name": "astro-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "cf:build:landing": "turbo run lint typecheck test build --filter=@astro/landing...",
    "cf:deploy:landing": "pnpm --filter @astro/landing run deploy"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "turbo": "^2.11.13",
    "typescript": "~6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
