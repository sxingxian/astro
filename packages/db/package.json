{
  "name": "@astro/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./migrate": "./src/migrate.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@astro/config": "workspace:*",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.0",
    "vitest": "^5.1.1"
  }
}
