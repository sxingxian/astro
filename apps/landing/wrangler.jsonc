{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-landing",
  "compatibility_date": "2026-11-01",
  // Serve only the custom domain: no *.workers.dev address and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "astro.midnightpoetry.studio", "custom_domain": true }
  ]
}
