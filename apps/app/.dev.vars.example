# Local development and CI only. Copy to .dev.vars (git-ignored). Never use these values in production.
APP_URL=http://127.0.0.1:8790
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
MAIL_DRIVER=outbox
TURNSTILE_MODE=off
HIBP_CHECK=off
# Cloudflare's published Turnstile test keys (always pass).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ADMIN_URL=http://127.0.0.1:8791/admin
