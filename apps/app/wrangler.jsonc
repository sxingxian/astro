{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // No address of its own (free-plan Stage 1): astro-api owns the app's domain and passes the reader pages here
  // through its LEGACY service binding. No *.workers.dev address and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // The Hyperdrive configuration astro-web (docs/DEPLOYMENT.md, step 5). Not secret.
      "id": "4d9c841ffad3409481d1af745953ef02",
      "localConnectionString": "postgres://astro_web:astro_web@127.0.0.1:5432/astro_dev"
    }
  ],
  "ratelimits": [{ "name": "GUEST_DRAWS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "APP_URL": "https://astroapp.midnightpoetry.studio",
    "ADMIN_URL": "https://astro.midnightpoetry.studio/admin",
    "EMAIL_FROM": "Astro <astro-noreply@app.midnightpoetry.studio>",
    "MAIL_DRIVER": "resend",
    "TURNSTILE_MODE": "on",
    "HIBP_CHECK": "on",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAGT4jVGbsgfhz3rb"
  },
  "observability": { "enabled": true },
  // Local wrangler dev keeps the browser's own host and Origin instead of rewriting them to the route above.
  "dev": { "ip": "127.0.0.1", "port": 8790, "host": "127.0.0.1:8790", "local_protocol": "http", "upstream_protocol": "http" }
}
