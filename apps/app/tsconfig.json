{
  "extends": "@astro/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "paths": {
      "next/navigation": [
        "../web/src/shims/navigation.ts"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "test-results"
  ]
}
