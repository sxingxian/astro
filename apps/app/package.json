{
  "name": "@astro/app",
  "version": "0.0.0",
  "private": true,
  "description": "Shared screen components and helpers used by apps/web, plus the app's unit and browser tests. The Next.js app that lived here (astro-app) was retired in Stage 2.",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astro/cards": "workspace:*",
    "@astro/copy": "workspace:*",
    "@astro/db": "workspace:*",
    "@astro/draw": "workspace:*",
    "@astro/meanings": "workspace:*",
    "@astro/server": "workspace:*",
    "@astro/ui": "workspace:*",
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "@astro/app-core": "workspace:*"
  },
  "devDependencies": {
    "@astro/config": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.15.0",
    "otpauth": "^9.6.0",
    "postgres": "^4.1.1",
    "typescript": "~6.0.0",
    "vitest": "^5.1.1"
  }
}
