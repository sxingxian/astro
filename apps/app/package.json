{
  "name": "@astro/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && wrangler dev --port 8790",
    "deploy": "opennextjs-cloudflare deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@astro/cards": "workspace:*",
    "@astro/db": "workspace:*",
    "@astro/draw": "workspace:*",
    "@astro/meanings": "workspace:*",
    "@astro/tokens": "workspace:*",
    "@astro/ui": "workspace:*",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.19",
    "better-auth": "^1.7.28",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.40.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astro/config": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "otpauth": "^9.6.0",
    "postgres": "^4.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
