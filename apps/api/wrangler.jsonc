{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The app Worker (free-plan design, Stage 1): the pre-built pages (apps/web) as static files, the API under /api,
  // and the reader pages not yet rebuilt passed to the old app (astro-app) through the LEGACY service binding.
  "name": "astro-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Builds the pages before every deploy, so Cloudflare's build settings stay as they are.
  "build": { "command": "pnpm --filter @astro/web build", "watch_dir": "../web/src" },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // Keep in step with LEGACY_ROUTES in src/legacy.ts (a test checks).
    "run_worker_first": ["/api/*", "/desk", "/desk/*", "/invite", "/invite/", "/offer", "/offer/", "/reader-guidelines", "/reader-guidelines/", "/_next/*"]
  },
  "workers_dev": false,
  "preview_urls": false,
  // Cutover (docs/DEPLOYMENT.md §18): the custom domain moves here from astro-app.
  "routes": [{ "pattern": "astroapp.midnightpoetry.studio", "custom_domain": true }],
  "services": [{ "binding": "LEGACY", "service": "astro-app" }],
  "ratelimits": [{ "name": "GUEST_DRAWS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Secrets, set in the Cloudflare dashboard (docs/DEPLOYMENT.md): DATABASE_URL (Neon, astro_web role),
  // BETTER_AUTH_SECRET (the same value as astro-app), PASS_SECRET (32+ characters), RESEND_API_KEY, TURNSTILE_SECRET_KEY.
  "vars": {
    "APP_URL": "https://astroapp.midnightpoetry.studio",
    "ADMIN_URL": "https://astro.midnightpoetry.studio/admin",
    "EMAIL_FROM": "Astro <astro-noreply@app.midnightpoetry.studio>",
    "MAIL_DRIVER": "resend",
    "TURNSTILE_MODE": "on",
    "HIBP_CHECK": "on",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAGT4jVGbsgfhz3rb"
  },
  "keep_vars": true,
  "observability": { "enabled": true },
  "dev": { "ip": "127.0.0.1", "port": 8792, "host": "127.0.0.1:8792", "local_protocol": "http", "upstream_protocol": "http" }
}
