    "@astro/draw": "workspace:*",
    "@astro/server": "workspace:*",
    "@neondatabase/serverless": "^1.2.1",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@astro/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "postgres": "^4.1.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0",
    "ws": "^8.21.0"
  }
