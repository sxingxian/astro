{
  "name": "@astro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "test:db": "vitest run --config vitest.db.config.ts",
