{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "out/**",
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        ".open-next/**"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "e2e": {
      "dependsOn": [
        "build"
      ],
      "passThroughEnv": [
        "CI",
        "E2E_BASE_URL",
        "DATABASE_URL_TEST"
      ]
    },
    "test:db": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL_TEST"
      ]
    }
  }
}
